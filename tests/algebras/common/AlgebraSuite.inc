// Generic tests of a library generated by Garamon. This file is included by a test source dedicated to an algebra,
// after the following definitions:
//
//     #include <xxx/Mvec.hpp>                              // IWYU pragma: keep (the library is used by this file)
//     namespace ga = xxx;                                  // namespace of the generated library
//     #define GA_TAG "[xxx]"                               // Catch2 tag of the algebra
//     #define GA_FULL_RANK 1                               // 1 if the metric is not degenerate (dual, Iinv, ... are defined), else 0
//     static const std::vector<std::vector<double>> gaMetric = {...};   // metric of the configuration file
//
// Most of the tests compare the library with garamon_test::CliffordReference, an independent naive implementation
// of the geometric algebra defined by the same metric.
//
// Includes: this file is not a self-contained header, so clangd does not see the library used by it. The including
// file marks its Mvec.hpp include with "IWYU pragma: keep", and the Catch2 headers below are exported to the
// including file, which may add its own tests after this file.

