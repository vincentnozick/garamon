namespace {

using Mv  = ga::Mvec<double>;
using Ref = garamon_test::CliffordReference;
using RefMv = Ref::Mv;

constexpr unsigned int gaDim  = ga::algebraDimension;
constexpr unsigned int gaSize = 1u << ga::algebraDimension;
constexpr double tolerance = 1.0e-9;

const Ref &reference() {
    static const Ref ref(gaMetric);
    return ref;
}

unsigned int gradeOf(const unsigned int xorIndex) { return Ref::grade(xorIndex); }

// name of a basis blade, e.g. "e12" or "1" for the scalar
std::string bladeName(const unsigned int xorIndex) {
    if(xorIndex == 0)
        return "1";
    std::string name = "e";
    for(unsigned int i = 0; i < gaDim; ++i)
        if(xorIndex & (1u << i))
            name += ga::basisVectors[i];
    return name;
}

// library multivector -> reference multivector
RefMv toRef(const Mv &mv) {
    RefMv result(gaSize, 0.0);
    for(unsigned int i = 0; i < gaSize; ++i)
        result[i] = mv[(int)i];
    return result;
}

Mv basisBlade(const unsigned int xorIndex, const double coefficient = 1.0) {
    Mv mv;
    mv[(int)xorIndex] = coefficient;
    return mv;
}

std::string toString(const RefMv &x) {
    std::ostringstream stream;
    bool first = true;
    for(unsigned int i = 0; i < gaSize; ++i) {
        if(x[i] == 0.0)
            continue;
        stream << (first ? "" : " + ") << x[i] << "*" << bladeName(i);
        first = false;
    }
    if(first)
        stream << "0";
    return stream.str();
}

double maxAbsDiff(const Mv &a, const RefMv &b) { return Ref::maxAbsDiff(toRef(a), b); }
double maxAbsDiff(const Mv &a, const Mv &b) { return Ref::maxAbsDiff(toRef(a), toRef(b)); }

// a multivector equal to 0 should not contain any non-zero component (and should not contain any grade)
bool sameMv(const Mv &a, const RefMv &b) { return maxAbsDiff(a, b) <= tolerance; }
bool sameMv(const Mv &a, const Mv &b) { return maxAbsDiff(a, b) <= tolerance; }

// random multivector with small integer coefficients (the products are then exact), 'density' is the probability
// of a component to be non-zero, 'gradeMask' selects the grades that may be non-zero
Mv randomMv(std::mt19937 &rng, const double density = 0.5, const unsigned int gradeMask = ~0u) {
    std::uniform_int_distribution<int> coefficient(-3, 3);
    std::bernoulli_distribution keep(density);
    Mv mv;
    for(unsigned int i = 0; i < gaSize; ++i) {
        if(!(gradeMask & (1u << gradeOf(i))) || !keep(rng))
            continue;
        const int c = coefficient(rng);
        if(c != 0)
            mv[(int)i] = c;
    }
    return mv;
}

Mv randomVector(std::mt19937 &rng) { return randomMv(rng, 1.0, 1u << 1); }

// compare a library binary operation with the reference on every pair of basis blades, report the first failures
template<typename LibraryOperation, typename ReferenceOperation>
void checkAllBladePairs(const std::string &operationName, LibraryOperation libraryOperation, ReferenceOperation referenceOperation) {
    unsigned int failures = 0;
    for(unsigned int a = 0; a < gaSize; ++a)
        for(unsigned int b = 0; b < gaSize; ++b) {
            const Mv result = libraryOperation(basisBlade(a), basisBlade(b));
            const RefMv expected = referenceOperation(reference().blade(a), reference().blade(b));
            if(!sameMv(result, expected)) {
                if(++failures <= 5) {
                    INFO(operationName << "(" << bladeName(a) << ", " << bladeName(b) << ")");
                    INFO("library  : " << toString(toRef(result)));
                    INFO("reference: " << toString(expected));
                    CHECK(sameMv(result, expected));
                }
            }
        }
    INFO(operationName << ": " << failures << " wrong product(s) of basis blades out of " << gaSize * gaSize);
    CHECK(failures == 0);
}

// compare a library binary operation with the reference on random multivectors
template<typename LibraryOperation, typename ReferenceOperation>
void checkRandomPairs(const std::string &operationName, LibraryOperation libraryOperation, ReferenceOperation referenceOperation,
                      const unsigned int count = 50) {
    std::mt19937 rng(42);
    for(unsigned int t = 0; t < count; ++t) {
        const Mv a = randomMv(rng, 0.3);
        const Mv b = randomMv(rng, 0.3);
        const Mv result = libraryOperation(a, b);
        const RefMv expected = referenceOperation(toRef(a), toRef(b));
        if(!sameMv(result, expected)) {
            INFO(operationName << " of random multivectors, test " << t);
            INFO("a        : " << toString(toRef(a)));
            INFO("b        : " << toString(toRef(b)));
            INFO("library  : " << toString(toRef(result)));
            INFO("reference: " << toString(expected));
            CHECK(sameMv(result, expected));
            return;
        }
    }
    SUCCEED(operationName << ": " << count << " random products match the reference");
}

// grades actually present in a multivector (non-zero components only)
std::vector<unsigned int> nonZeroGrades(const Mv &mv) {
    std::vector<unsigned int> grades;
    const RefMv x = toRef(mv);
    for(unsigned int k = 0; k <= gaDim; ++k)
        for(unsigned int i = 0; i < gaSize; ++i)
            if(gradeOf(i) == k && x[i] != 0.0) {
                grades.push_back(k);
                break;
            }
    return grades;
}

} // namespace


// ====================================================================================================================
// generated constants

TEST_CASE("generated constants are consistent", GA_TAG "[constants]") {

    REQUIRE(ga::algebraDimension == gaMetric.size());
    REQUIRE(ga::basisVectors.size() == ga::algebraDimension);
    CHECK(ga::scalar == 0u);

    unsigned int start = 0;
    for(unsigned int k = 0; k <= gaDim; ++k) {
        unsigned int count = 0;
        for(unsigned int i = 0; i < gaSize; ++i)
            if(gradeOf(i) == k)
                ++count;
        INFO("grade " << k);
        CHECK(ga::binomialArray[k] == count);
        CHECK(ga::perGradeStartingIndex[k] == start);
        CHECK(ga::signReversePerGrade[k] == ((k % 4 == 2 || k % 4 == 3) ? -1 : 1)); // (-1)^{k(k-1)/2}
        start += count;
    }

    // xor index -> (grade, position in the k-vector): positions are a bijection on each grade
    for(unsigned int k = 0; k <= gaDim; ++k) {
        std::vector<bool> used(ga::binomialArray[k], false);
        for(unsigned int i = 0; i < gaSize; ++i) {
            if(gradeOf(i) != k)
                continue;
            INFO("xor index " << i);
            CHECK(ga::xorIndexToGrade[i] == k);
            REQUIRE(ga::xorIndexToHomogeneousIndex[i] < ga::binomialArray[k]);
            CHECK_FALSE(used[ga::xorIndexToHomogeneousIndex[i]]);
            used[ga::xorIndexToHomogeneousIndex[i]] = true;
        }
    }
}

TEST_CASE("generated utility functions", GA_TAG "[utility]") {
    CHECK(ga::bin_coeff(5, 2) == 10u);
    CHECK(ga::bin_coeff(5, 0) == 1u);
    CHECK(ga::bin_coeff(5, 6) == 0u);
    CHECK(ga::bin_coeff(16, 8) == 12870u); // 16! overflows 32 bits
    CHECK(ga::bin_coeff(30, 15) == 155117520u);
    CHECK(ga::Binomial<5, 2>::value == 10);
    CHECK(ga::factorial(5) == 120u);

    constexpr auto sorted = ga::sortAndDetermineSign<3, 1, 2>();
    CHECK(sorted[0] == 1);
    CHECK(sorted[1] == 2);
    CHECK(sorted[2] == 3);
    CHECK(sorted.sign == 1);  // 2 transpositions
    constexpr auto swapped = ga::sortAndDetermineSign<2, 1>();
    CHECK(swapped[0] == 1);
    CHECK(swapped[1] == 2);
    CHECK(swapped.sign == -1); // 1 transposition
    constexpr auto alreadySorted = ga::sortAndDetermineSign<1, 2, 3>();
    CHECK(alreadySorted.sign == 1);
}


// ====================================================================================================================
// products

TEST_CASE("inner products of basis vectors define the metric", GA_TAG "[metric]") {
    for(unsigned int i = 0; i < gaDim; ++i)
        for(unsigned int j = 0; j < gaDim; ++j) {
            INFO("e" << ga::basisVectors[i] << " . e" << ga::basisVectors[j]);
            const Mv ei = basisBlade(1u << i);
            const Mv ej = basisBlade(1u << j);
            const Mv inner = ei | ej;
            CHECK(inner.grade() == 0);
            CHECK(inner[ga::scalar] == Catch::Approx(gaMetric[i][j]).margin(tolerance));

            // e_i e_j + e_j e_i = 2 B(e_i, e_j)
            const Mv anticommutator = ei * ej + ej * ei;
            CHECK(sameMv(anticommutator, reference().scalar(2.0 * gaMetric[i][j])));

            // e_i ^ e_j = - e_j ^ e_i
            CHECK(sameMv((ei ^ ej) + (ej ^ ei), reference().zero()));
        }
}

TEST_CASE("products of basis blades match the reference", GA_TAG "[products][blades]") {
    const Ref &ref = reference();

    SECTION("geometric product *") {
        checkAllBladePairs("a*b", [](const Mv &a, const Mv &b) { return a * b; },
                           [&ref](const RefMv &a, const RefMv &b) { return ref.geometric(a, b); });
    }
    SECTION("outer product ^") {
        checkAllBladePairs("a^b", [](const Mv &a, const Mv &b) { return a ^ b; },
                           [&ref](const RefMv &a, const RefMv &b) { return ref.outer(a, b); });
    }
    SECTION("inner product |") {
        checkAllBladePairs("a|b", [](const Mv &a, const Mv &b) { return a | b; },
                           [&ref](const RefMv &a, const RefMv &b) { return ref.inner(a, b); });
    }
    SECTION("left contraction <") {
        checkAllBladePairs("a<b", [](const Mv &a, const Mv &b) { return a < b; },
                           [&ref](const RefMv &a, const RefMv &b) { return ref.leftContraction(a, b); });
    }
    SECTION("right contraction >") {
        checkAllBladePairs("a>b", [](const Mv &a, const Mv &b) { return a > b; },
                           [&ref](const RefMv &a, const RefMv &b) { return ref.rightContraction(a, b); });
    }
    SECTION("scalar product") {
        checkAllBladePairs("a.scalarProduct(b)", [](const Mv &a, const Mv &b) { return a.scalarProduct(b); },
                           [&ref](const RefMv &a, const RefMv &b) { return ref.scalarProduct(a, b); });
    }
    SECTION("dot product") {
        checkAllBladePairs("a.dotProduct(b)", [](const Mv &a, const Mv &b) { return a.dotProduct(b); },
                           [&ref](const RefMv &a, const RefMv &b) { return ref.dot(a, b); });
    }
    SECTION("leftContraction() and rightContraction() functions") {
        checkAllBladePairs("leftContraction(a,b)", [](const Mv &a, const Mv &b) { return ga::leftContraction(a, b); },
                           [&ref](const RefMv &a, const RefMv &b) { return ref.leftContraction(a, b); });
        checkAllBladePairs("rightContraction(a,b)", [](const Mv &a, const Mv &b) { return ga::rightContraction(a, b); },
                           [&ref](const RefMv &a, const RefMv &b) { return ref.rightContraction(a, b); });
    }
}

TEST_CASE("products of random multivectors match the reference", GA_TAG "[products][random]") {
    const Ref &ref = reference();

    checkRandomPairs("a*b", [](const Mv &a, const Mv &b) { return a * b; },
                     [&ref](const RefMv &a, const RefMv &b) { return ref.geometric(a, b); });
    checkRandomPairs("a^b", [](const Mv &a, const Mv &b) { return a ^ b; },
                     [&ref](const RefMv &a, const RefMv &b) { return ref.outer(a, b); });
    checkRandomPairs("a|b", [](const Mv &a, const Mv &b) { return a | b; },
                     [&ref](const RefMv &a, const RefMv &b) { return ref.inner(a, b); });
    checkRandomPairs("a<b", [](const Mv &a, const Mv &b) { return a < b; },
                     [&ref](const RefMv &a, const RefMv &b) { return ref.leftContraction(a, b); });
    checkRandomPairs("a>b", [](const Mv &a, const Mv &b) { return a > b; },
                     [&ref](const RefMv &a, const RefMv &b) { return ref.rightContraction(a, b); });
    checkRandomPairs("a.scalarProduct(b)", [](const Mv &a, const Mv &b) { return a.scalarProduct(b); },
                     [&ref](const RefMv &a, const RefMv &b) { return ref.scalarProduct(a, b); });
    checkRandomPairs("a.dotProduct(b)", [](const Mv &a, const Mv &b) { return a.dotProduct(b); },
                     [&ref](const RefMv &a, const RefMv &b) { return ref.dot(a, b); });
    checkRandomPairs("a+b", [](const Mv &a, const Mv &b) { return a + b; },
                     [](const RefMv &a, const RefMv &b) { return Ref::add(a, b); });
    checkRandomPairs("a-b", [](const Mv &a, const Mv &b) { return a - b; },
                     [](const RefMv &a, const RefMv &b) { return Ref::sub(a, b); });
}

TEST_CASE("products do not keep null grades", GA_TAG "[products]") {
    // the products remove the k-vectors whose components are all zero
    std::mt19937 rng(7);
    for(unsigned int t = 0; t < 30; ++t) {
        const Mv a = randomMv(rng, 0.3);
        const Mv b = randomMv(rng, 0.3);
        for(const Mv &product : {Mv(a * b), Mv(a ^ b), Mv(a | b), Mv(a < b), Mv(a > b)}) {
            std::vector<unsigned int> grades = product.grades();
            CHECK(grades == nonZeroGrades(product));
        }
    }
}

TEST_CASE("algebraic identities", GA_TAG "[identities]") {
    std::mt19937 rng(1234);

    SECTION("associativity of the geometric and outer products") {
        for(unsigned int t = 0; t < 20; ++t) {
            const Mv a = randomMv(rng, 0.25), b = randomMv(rng, 0.25), c = randomMv(rng, 0.25);
            CHECK(sameMv((a * b) * c, a * (b * c)));
            CHECK(sameMv((a ^ b) ^ c, a ^ (b ^ c)));
        }
    }

    SECTION("distributivity") {
        for(unsigned int t = 0; t < 20; ++t) {
            const Mv a = randomMv(rng, 0.25), b = randomMv(rng, 0.25), c = randomMv(rng, 0.25);
            CHECK(sameMv(a * (b + c), a * b + a * c));
            CHECK(sameMv((a + b) ^ c, (a ^ c) + (b ^ c)));
            CHECK(sameMv(a | (b - c), (a | b) - (a | c)));
        }
    }

    SECTION("vector products: ab = a.b + a^b and aB = a_|B + a^B") {
        for(unsigned int t = 0; t < 20; ++t) {
            const Mv a = randomVector(rng);
            const Mv b = randomVector(rng);
            const Mv B = randomMv(rng, 0.5);
            CHECK(sameMv(a * b, (a | b) + (a ^ b)));
            CHECK(sameMv(a * B, (a < B) + (a ^ B)));
            CHECK(sameMv(B * a, (B > a) + (B ^ a)));
        }
    }

    SECTION("reverse") {
        for(unsigned int t = 0; t < 20; ++t) {
            const Mv a = randomMv(rng, 0.3), b = randomMv(rng, 0.3);
            CHECK(sameMv(~(a * b), (~b) * (~a)));
            CHECK(sameMv(a.reverse(), reference().reverse(toRef(a))));
            CHECK(sameMv(~a, a.reverse()));
            CHECK(sameMv(~~a, a));
        }
    }

    SECTION("scalar part of a geometric product is symmetric") {
        for(unsigned int t = 0; t < 20; ++t) {
            const Mv a = randomMv(rng, 0.3), b = randomMv(rng, 0.3);
            CHECK(double((a * b).grade(0)) == Catch::Approx(double((b * a).grade(0))).margin(tolerance));
        }
    }
}

TEST_CASE("compound assignment operators", GA_TAG "[operators]") {
    std::mt19937 rng(99);
    for(unsigned int t = 0; t < 20; ++t) {
        const Mv a = randomMv(rng, 0.3), b = randomMv(rng, 0.3);
        Mv c;
        c = a; c += b; CHECK(sameMv(c, a + b));
        c = a; c -= b; CHECK(sameMv(c, a - b));
        c = a; c *= b; CHECK(sameMv(c, a * b));
        c = a; c ^= b; CHECK(sameMv(c, a ^ b));
        c = a; c |= b; CHECK(sameMv(c, a | b));
        c = a; c /= 4.0; CHECK(sameMv(c, a * 0.25));

        // self assignment
        c = a; c += c; CHECK(sameMv(c, a * 2.0));
        const Mv &alias = c;
        c = a; c = alias; CHECK(sameMv(c, a));
    }
}

TEST_CASE("operations with scalars", GA_TAG "[operators][scalar]") {
    std::mt19937 rng(5);
    for(unsigned int t = 0; t < 20; ++t) {
        const Mv a = randomMv(rng, 0.4);
        const double s = 3.0;
        const Mv S(s);
        const double scalarPartOfA = a[ga::scalar];

        CHECK(sameMv(a + s, a + S));
        CHECK(sameMv(s + a, a + S));
        CHECK(sameMv(a - s, a - S));
        CHECK(sameMv(s - a, S - a));
        CHECK(sameMv(a * s, a * S));
        CHECK(sameMv(s * a, S * a));
        CHECK(sameMv(a / s, a * (1.0 / s)));
        CHECK(sameMv(a ^ s, a ^ S));
        CHECK(sameMv(s ^ a, S ^ a));

        // the inner product with a scalar is 0
        CHECK((a | s).isEmpty());
        CHECK((s | a).isEmpty());
        CHECK(sameMv(a | S, reference().zero()));

        // contractions with a scalar
        CHECK(sameMv(s < a, S < a));
        CHECK(sameMv(s < a, a * s));
        CHECK(sameMv(a < s, a < S));
        CHECK(sameMv(a < s, reference().scalar(scalarPartOfA * s)));
        CHECK(sameMv(a > s, a > S));
        CHECK(sameMv(a > s, a * s));
        CHECK(sameMv(s > a, S > a));
        CHECK(sameMv(s > a, reference().scalar(scalarPartOfA * s)));

        // the operators with a scalar 0
        CHECK(sameMv(a + 0.0, a));
        CHECK(sameMv(a * 0.0, reference().zero()));
    }
}


// ====================================================================================================================
// dual, pseudo-scalar, inverse

TEST_CASE("pseudo-scalar", GA_TAG "[pseudoscalar]") {
    const Mv I = ga::I<double>();
    REQUIRE(I.grades() == std::vector<unsigned int>{gaDim});
    CHECK(I[(int)(gaSize - 1)] == 1.0);
    CHECK(I.isHomogeneous());

#if GA_FULL_RANK
    const Mv Iinv = ga::Iinv<double>();
    REQUIRE(Iinv.grades() == std::vector<unsigned int>{gaDim});
    CHECK(sameMv(I * Iinv, reference().scalar(1.0)));
    CHECK(sameMv(Iinv * I, reference().scalar(1.0)));
    CHECK(sameMv(I.inv(), Iinv));
#else
    // degenerate metric: the pseudo-scalar is null
    CHECK(sameMv(I * I, reference().zero()));
#endif
}

#if GA_FULL_RANK

TEST_CASE("dual is the left contraction onto the pseudo-scalar", GA_TAG "[dual]") {
    const Mv I = ga::I<double>();
    const RefMv refI = reference().pseudoScalar();

    unsigned int failures = 0;
    for(unsigned int a = 0; a < gaSize; ++a) {
        const Mv blade = basisBlade(a, 2.0);
        const Mv dual = blade.dual();
        const RefMv expected = reference().leftContraction(toRef(blade), refI);
        if(!sameMv(dual, expected) && ++failures <= 5) {
            INFO("dual(2*" << bladeName(a) << ")");
            INFO("library  : " << toString(toRef(dual)));
            INFO("reference: " << toString(expected));
            CHECK(sameMv(dual, expected));
        }
        CHECK(sameMv(!blade, dual));
        CHECK(sameMv(blade < I, expected));
    }
    CHECK(failures == 0);

    // linearity, and undual: dual(dual(A)) = A I I
    std::mt19937 rng(3);
    for(unsigned int t = 0; t < 20; ++t) {
        const Mv a = randomMv(rng, 0.4), b = randomMv(rng, 0.4);
        CHECK(sameMv((a + b).dual(), a.dual() + b.dual()));
        CHECK(sameMv(a.dual(), reference().leftContraction(toRef(a), refI)));
        CHECK(sameMv(a.dual().dual(), a * I * I));
    }
}

TEST_CASE("outer products with dual operands", GA_TAG "[dual]") {
    const Ref &ref = reference();
    const RefMv refI = ref.pseudoScalar();
    auto dualRef = [&ref, &refI](const RefMv &x) { return ref.leftContraction(x, refI); };

    checkAllBladePairs("a.outerPrimalDual(b)", [](const Mv &a, const Mv &b) { return a.outerPrimalDual(b); },
                       [&ref, dualRef](const RefMv &a, const RefMv &b) { return ref.outer(a, dualRef(b)); });
    checkAllBladePairs("a.outerDualPrimal(b)", [](const Mv &a, const Mv &b) { return a.outerDualPrimal(b); },
                       [&ref, dualRef](const RefMv &a, const RefMv &b) { return ref.outer(dualRef(a), b); });
    checkAllBladePairs("a.outerDualDual(b)", [](const Mv &a, const Mv &b) { return a.outerDualDual(b); },
                       [&ref, dualRef](const RefMv &a, const RefMv &b) { return ref.outer(dualRef(a), dualRef(b)); });

    // the documented equivalences
    std::mt19937 rng(11);
    for(unsigned int t = 0; t < 20; ++t) {
        const Mv a = randomMv(rng, 0.3), b = randomMv(rng, 0.3);
        CHECK(sameMv(a.outerPrimalDual(b), a ^ b.dual()));
        CHECK(sameMv(a.outerDualPrimal(b), a.dual() ^ b));
        CHECK(sameMv(a.outerDualDual(b), a.dual() ^ b.dual()));
    }
}

#else

TEST_CASE("dual is the right complement for a degenerate metric", GA_TAG "[dual]") {
    const Mv I = ga::I<double>();
    for(unsigned int a = 0; a < gaSize; ++a) {
        INFO("blade " << bladeName(a));
        const Mv blade = basisBlade(a);
        const Mv complement = blade.dual();
        CHECK(sameMv(complement, reference().rightComplement(toRef(blade))));
        CHECK(sameMv(blade ^ complement, I));
        CHECK(sameMv(!blade, complement));
    }

    std::mt19937 rng(3);
    for(unsigned int t = 0; t < 20; ++t) {
        const Mv a = randomMv(rng, 0.4), b = randomMv(rng, 0.4);
        CHECK(sameMv((a + b).dual(), a.dual() + b.dual()));
        CHECK(sameMv(a.dual(), reference().rightComplement(toRef(a))));
    }
}

#endif

TEST_CASE("inverse", GA_TAG "[inverse]") {
    const Ref &ref = reference();

    SECTION("basis blades") {
        for(unsigned int a = 0; a < gaSize; ++a) {
            INFO("blade 2*" << bladeName(a));
            const Mv blade = basisBlade(a, 2.0);
            const RefMv square = ref.geometric(toRef(blade), ref.reverse(toRef(blade)));
            if(std::fabs(square[0]) < tolerance) {
                // null blade: inv() returns 0
                CHECK(blade.inv().isEmpty());
                continue;
            }
            CHECK(sameMv(blade * blade.inv(), ref.scalar(1.0)));
            CHECK(sameMv(blade.inv() * blade, ref.scalar(1.0)));
            CHECK(sameMv(blade / blade, ref.scalar(1.0)));
        }
    }

    SECTION("versors") {
        std::mt19937 rng(17);
        unsigned int tested = 0;
        for(unsigned int t = 0; t < 200 && tested < 30; ++t) {
            // product of 1 to 3 non-null vectors
            Mv versor(1.0);
            bool nonNull = true;
            const unsigned int count = 1 + t % 3;
            for(unsigned int k = 0; k < count; ++k) {
                const Mv v = randomVector(rng);
                if(std::fabs(double(v * v)) < 0.5)
                    nonNull = false;
                versor = versor * v;
            }
            if(!nonNull)
                continue;
            ++tested;
            INFO("versor: " << toString(toRef(versor)));
            CHECK(sameMv(versor * versor.inv(), ref.scalar(1.0)));
            CHECK(sameMv(versor.inv() * versor, ref.scalar(1.0)));
            CHECK(sameMv(1.0 / versor, versor.inv()));
        }
        CHECK(tested > 0);
    }

    SECTION("division") {
        std::mt19937 rng(23);
        for(unsigned int t = 0; t < 20; ++t) {
            const Mv a = randomMv(rng, 0.3);
            const Mv v = randomVector(rng);
            CHECK(sameMv(a / v, a * v.inv()));
            Mv c = a;
            c /= v;
            CHECK(sameMv(c, a / v));
        }
        CHECK(sameMv(Mv(4.0).inv(), ref.scalar(0.25)));
    }
}

TEST_CASE("norms", GA_TAG "[norm]") {
    const Ref &ref = reference();
    std::mt19937 rng(31);
    for(unsigned int t = 0; t < 30; ++t) {
        const Mv a = randomMv(rng, 0.3);
        const RefMv x = toRef(a);
        const double scalarProduct = ref.scalarProduct(x, ref.reverse(x))[0];
        INFO("a = " << toString(x));
        CHECK(a.quadraticNorm() == Catch::Approx(scalarProduct).margin(tolerance));
        CHECK(a.norm() == Catch::Approx(std::sqrt(std::fabs(scalarProduct))).margin(tolerance));
    }
}


// ====================================================================================================================
// container behaviour

TEST_CASE("construction", GA_TAG "[container]") {

    SECTION("default") {
        const Mv mv;
        CHECK(mv.isEmpty());
        CHECK(mv.grades().empty());
        CHECK(mv.grade() == 0);
        CHECK(double(mv) == 0.0);
    }

    SECTION("from a scalar") {
        const Mv mv(5);
        CHECK(mv[ga::scalar] == 5.0);
        CHECK(mv.grade() == 0);
        CHECK(mv.grades() == std::vector<unsigned int>{0});
        const Mv mv2(2.5f);
        CHECK(mv2[ga::scalar] == 2.5);
    }

    SECTION("from a null scalar") {
        // the multivector is empty, its grade bitmap must be empty too
        const Mv mv(0);
        CHECK(mv.isEmpty());
        CHECK(mv.grades().empty());
        CHECK_FALSE(mv.isGrade(1));
        const Mv sum = mv + basisBlade(1);
        CHECK(sum.grades() == std::vector<unsigned int>{1});
        const Mv mv2(0.0);
        CHECK(mv2 == Mv());
    }

    SECTION("copy, move and type conversion") {
        std::mt19937 rng(2);
        const Mv a = randomMv(rng, 0.5);
        Mv copy(a);
        CHECK(copy == a);
        Mv moved(std::move(copy));
        CHECK(moved == a);
        Mv assigned;
        assigned = a;
        CHECK(assigned == a);
        Mv moveAssigned;
        moveAssigned = Mv(a);
        CHECK(moveAssigned == a);

        const ga::Mvec<float> f(a);
        CHECK(f.grades() == a.grades());
        const Mv back(f);
        CHECK(sameMv(back, a));
    }
}

TEST_CASE("component access", GA_TAG "[container]") {
    Mv mv;
    mv[(int)(gaSize - 1)] = 4.0;
    mv[1] = 1.0;
    mv[ga::scalar] = 3.0;
    CHECK(mv.grades() == (gaDim == 1 ? std::vector<unsigned int>{0, 1} : std::vector<unsigned int>{0, 1, gaDim}));

    // the k-vectors are stored by increasing grade, whatever the insertion order
    CHECK(mv.grade() == (int)gaDim);
    CHECK(mv[1] == 1.0);
    CHECK(mv[(int)(gaSize - 1)] == 4.0);

    // a const access to a missing component returns 0 and does not create it
    const Mv &constMv = mv;
    if(gaDim > 2) {
        CHECK(constMv[3] == 0.0);
        CHECK_FALSE(constMv.isGrade(2));
    }

    // all the components are independent
    Mv full;
    for(unsigned int i = 0; i < gaSize; ++i)
        full[(int)i] = (double)i + 1.0;
    for(unsigned int i = 0; i < gaSize; ++i)
        CHECK(full[(int)i] == (double)i + 1.0);
    CHECK(full.grades().size() == gaDim + 1);
    CHECK(sameMv(full, toRef(full)));

    // at(grade, index)
    const Mv &constFull = full;
    for(unsigned int i = 0; i < gaSize; ++i)
        CHECK(constFull.at((int)ga::xorIndexToGrade[i], (int)ga::xorIndexToHomogeneousIndex[i]) == (double)i + 1.0);
}

TEST_CASE("grades", GA_TAG "[container]") {
    Mv mv;
    mv[1] = 2.0;
    if(gaDim >= 2)
        mv[3] = 3.0;

    CHECK(mv.isGrade(1));
    CHECK_FALSE(mv.isGrade(0));
    CHECK(Mv().isGrade(0)); // the empty multivector is the scalar 0
    CHECK(mv.isHomogeneous() == (gaDim < 2));
    CHECK(mv.grade(1) == basisBlade(1, 2.0));
    CHECK(mv.grade(0).isEmpty());

    if(gaDim >= 2) {
        CHECK(mv.grades() == std::vector<unsigned int>{1, 2});
        CHECK(mv.grade() == 2);
        CHECK(mv.sameGrade(basisBlade(3)));
        CHECK_FALSE(mv.sameGrade(basisBlade(1)));

        Mv cleared = mv;
        cleared.clear(2);
        CHECK(cleared.grades() == std::vector<unsigned int>{1});
        cleared.clear(2); // clearing a missing grade does nothing
        CHECK(cleared.grades() == std::vector<unsigned int>{1});
    }

    Mv cleared = mv;
    cleared.clear();
    CHECK(cleared.isEmpty());
    CHECK(cleared.grades().empty());
}

TEST_CASE("roundZero", GA_TAG "[container]") {
    Mv mv;
    mv[ga::scalar] = 1.0e-12;
    mv[1] = 2.0;
    mv[(int)(gaSize - 1)] = -1.0e-10;
    mv.roundZero(1.0e-9);
    CHECK(mv.grades() == std::vector<unsigned int>{1});
    CHECK(mv[1] == 2.0);
    CHECK(mv[ga::scalar] == 0.0);

    Mv tiny;
    tiny[1] = 1.0e-20;
    tiny.roundZero();
    CHECK(tiny.isEmpty());
}

TEST_CASE("comparison operators", GA_TAG "[container]") {
    std::mt19937 rng(8);
    const Mv a = randomMv(rng, 0.5);
    const Mv b = a;
    const Mv c = a + basisBlade(1, 1.0);
    CHECK(a == b);
    CHECK_FALSE(a != b);
    CHECK(a != c);
    CHECK_FALSE(a == c);
    CHECK(Mv() == Mv());
    if(gaDim >= 2)
        CHECK(basisBlade(1) != basisBlade(2));
}

TEST_CASE("conversion to scalar", GA_TAG "[container]") {
    Mv mv;
    CHECK(double(mv) == 0.0);
    mv[1] = 42.0;
    CHECK(double(mv) == 0.0);
    mv[ga::scalar] = 5.0;
    const Mv constMv = mv;
    CHECK(double(constMv) == 5.0);
    CHECK(int(constMv) == 5);
}

TEST_CASE("no implicit conversions", GA_TAG "[container]") {
    // a multivector is converted to its scalar part by an explicit cast only (fabs(mv) does not compile)
    STATIC_REQUIRE(std::is_constructible_v<double, Mv>);
    STATIC_REQUIRE(std::is_constructible_v<int, Mv>);
    STATIC_REQUIRE_FALSE(std::is_convertible_v<Mv, double>);
    // a multivector is implicitly constructed from an arithmetic type only (not e.g. from a string)
    STATIC_REQUIRE(std::is_convertible_v<double, Mv>);
    STATIC_REQUIRE(std::is_convertible_v<int, Mv>);
    STATIC_REQUIRE_FALSE(std::is_convertible_v<const char *, Mv>);
    STATIC_REQUIRE_FALSE(std::is_constructible_v<Mv, std::string>);
}

TEST_CASE("stream output", GA_TAG "[container]") {
    auto print = [](const Mv &mv) {
        std::ostringstream stream;
        stream << mv;
        return stream.str();
    };
    const std::string e1 = "e" + ga::basisVectors[0];

    CHECK(print(Mv()) == " 0 ");
    CHECK(print(Mv(2.0)) == "2");
    CHECK(print(basisBlade(1, 3.0)) == "3*" + e1);
    CHECK(print(Mv(2.0) + basisBlade(1, 3.0)) == "2 + 3*" + e1);
    CHECK(print(Mv(2.0) - basisBlade(1, 3.0)) == "2 - 3*" + e1);
    if(gaDim >= 2) {
        const std::string e12 = "e" + ga::basisVectors[0] + ga::basisVectors[1];
        CHECK(print(basisBlade(1, 1.5) - basisBlade(3, 2.0)) == "1.5*" + e1 + " - 2*" + e12);
    }
    // a multivector with explicit zero components only
    Mv zeros;
    zeros[1] = 0.0;
    CHECK(print(zeros) == " 0 ");
}
